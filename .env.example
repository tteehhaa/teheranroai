# Environment variables for the admin analytics dashboard (/admin).
#
# These live in Vercel > v0-teheranroai > Settings > Environment Variables, not
# in the repository. None is prefixed with NEXT_PUBLIC_, so Next cannot expose
# any of them to the browser bundle.

# Supabase project `pp_a` (ap-northeast-2), shared with theo-ne.com. Not a
# secret, but only the route handlers call it.
SUPABASE_URL=https://kimusrivsubyghfhrwng.supabase.co

# Supabase > Project Settings > API Keys > service_role. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in. The password is stored only as a scrypt hash; regenerate with
# the one-liner in docs/admin-analytics.md.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Signs the session cookie and salts the stored IP hashes.
ADMIN_SESSION_SECRET=

# Optional. Addresses whose visits are never recorded — the operator's own.
ANALYTICS_EXCLUDE_IPS=
